generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIPPER
  BUSINESS
  ADMIN
}

enum CampaignStatus {
  LIVE
  PAUSED
  ENDED
}

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
}

model User {
  id                 Int     @id @default(autoincrement())
  name               String
  username           String  @unique
  email              String? @unique
  mobile             String? @unique
  passwordHash       String
  role               Role    @default(CLIPPER)
  emailVerified      Boolean @default(false)
  mobileVerified     Boolean @default(false)
  avatar             String?
  isSuspended        Boolean @default(false)
  missionClaimedWeek String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verificationCodes VerificationCode[]
  resetTokens       ResetToken[]
  campaigns         Campaign[]
  submissions       Submission[]
  notifications     Notification[]
  transactions      Transaction[]
  payoutMethods     PayoutMethod[]
  payoutRequests    PayoutRequest[]
  reports           Report[]
  assets            Asset[]
  socialAccounts    SocialAccount[]
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  code      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String // 'EMAIL' or 'MOBILE'
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Campaign {
  id             Int            @id @default(autoincrement())
  title          String
  businessName   String
  niche          String
  platforms      String[]
  description    String
  do             String[]
  dont           String[]
  hookStyle      String?
  captionStyle   String?
  cta            String?
  hashtags       String[]
  videoLength    String?
  banner         String?
  logo           String?
  referenceLinks String[]
  audioNotes     String?
  rate           Float
  budget         Float
  startDate      DateTime?
  endDate        DateTime?
  status         CampaignStatus @default(LIVE)
  ownerId        Int
  owner          User           @relation(fields: [ownerId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

model Submission {
  id             Int              @id @default(autoincrement())
  campaignId     Int
  campaign       Campaign         @relation(fields: [campaignId], references: [id])
  clipperId      Int
  clipper        User             @relation(fields: [clipperId], references: [id])
  platform       String
  postUrl        String
  submittedViews Int
  verifiedViews  Int              @default(0)
  approvedViews  Int?
  rate           Float
  earnings       Float            @default(0)
  status         SubmissionStatus @default(PENDING)
  feedback       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  fraudScore   Float   @default(0.0)
  fraudFlags   String  @default("[]")
  isSuspicious Boolean @default(false)

  snapshots MetricSnapshot[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum TransactionType {
  CLIP_EARNING
  BONUS
  PAYOUT
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Transaction {
  id           Int             @id @default(autoincrement())
  userId       Int
  user         User            @relation(fields: [userId], references: [id])
  amount       Float
  type         TransactionType
  submissionId Int?
  reference    String?
  createdAt    DateTime        @default(now())
}

model PayoutMethod {
  id         Int             @id @default(autoincrement())
  userId     Int
  user       User            @relation(fields: [userId], references: [id])
  type       String
  identifier String
  createdAt  DateTime        @default(now())
  requests   PayoutRequest[]
}

model PayoutRequest {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  amount    Float
  status    PayoutStatus @default(PENDING)
  methodId  Int
  method    PayoutMethod @relation(fields: [methodId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum ReportType {
  USER
  CAMPAIGN
  SUBMISSION
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         Int          @id @default(autoincrement())
  reporterId Int
  reporter   User         @relation(fields: [reporterId], references: [id])
  targetId   Int?
  targetType ReportType
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Asset {
  id        Int      @id @default(autoincrement())
  url       String
  key       String   @unique
  fileType  String
  size      Int
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialAccount {
  id                Int            @id @default(autoincrement())
  platform          SocialPlatform
  providerAccountId String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  username          String?
  profileUrl        String?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, providerAccountId])
}

model MetricSnapshot {
  id         Int      @id @default(autoincrement())
  views      Int
  likes      Int
  comments   Int
  shares     Int      @default(0)
  capturedAt DateTime @default(now())

  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id])
}
